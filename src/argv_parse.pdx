// src/argv_parse.pdx -- pdxdig v1.2.0 (Wave W drain: argv surface).
//
// Wave: R100  Milestone: M1-002 (pdxdig#2), M2-003 (pdxdig#6)
// Doc:  design/networking/r100-user-tools-plan.md §6.1 + §13.5
//
// ArgvParse: pdxdig's inline argv-flag matcher. Two pure-leaf helpers
// used by Main::_start to peel `--dry-run`, `--type=`, `--server=`,
// and `--timeout-ms=` from argv without pulling libpdx-argv into
// pdxdig's link set at v1.2 (libpdx-argv wire-in still parked until
// the whole R100 tool family adopts it in one sweep).
//
// pdxdig v1.2.0 argv grammar (subset of §6.1 -- server/timeout-ms
// are recognized but no-op'd; the real bindings arrive with the
// M2-002 --server= landing and a future M2-004 --timeout-ms= landing):
//
//   pdxdig <name>                          -- STUB: emits DRY_RUN record + exit 3
//   pdxdig --dry-run <name>                -- REAL: emits DRY_RUN record + exit 0
//   pdxdig --type=A <name>                 -- alias of "<name>" (only supported qtype)
//   pdxdig --type=<other> <name>           -- REAL: emits UNSUPPORTED_QTYPE + exit 4
//   pdxdig --server=1.2.3.4 <name>         -- recognized, no-op at v1.2 (M2-002 real)
//   pdxdig --timeout-ms=500 <name>         -- recognized, no-op at v1.2
//   pdxdig                                 -- usage on fd 2; exit 2
//   pdxdig -<anything unrecognized>        -- usage on fd 2; exit 2
//
// Order-insensitivity: flags and positional may appear in any order;
// last positional wins (matches dig(1) tail-argument convention).
//
// Callable ABI (SysV amd64) -----------------------------------------
//   argv_parse_prefix(arg_ptr, prefix_ptr, prefix_len) -> u64
//   argv_parse_eq_len(arg_ptr, wanted_ptr, wanted_len) -> u64
//     rdi = first arg, rsi = second, rdx = third; rax = return.
//
// Both helpers are pure leaves: no callee-save touch, no push/pop,
// no stack use. Rsp%16==8 at entry (post-`call` from Main::_start)
// is fine for a leaf that never nests a call. Callers preserve any
// live values in rcx/r8/rax across the call themselves.
//
// paideia-as 0.36+ encoder discipline (per user memory `pdx encoder pitfalls`)
// --------------------------------------------------------------------
//   - No `test rN, rN` (every zero-check is `cmp rN, 0`).
//   - No 2-op `imul r, imm` (unused).
//   - No `and rN, imm64` on r8..r15 (unused).
//   - No `neg` mnemonic (unused).
//   - Byte loads via `xor rax, rax; mov_b rax, [ptr]` per paideia-as
//     #1248 (REX.W upper-bits contract for mov_b).
//   - Module basename PascalCase (`ArgvParse` for `argv_parse.pdx`).
//   - Every label prefixed `ap_pfx_` / `ap_eq_` (reserved-word
//     discipline; `loop` is a keyword and a bare `loop:` label fails
//     to parse -- see paideia-as reserved-labels memo).

module ArgvParse = structure {

  // -------------------------------------------------------------------
  // argv_parse_prefix(arg_ptr, prefix_ptr, prefix_len) -> u64
  //
  //   rdi = arg_ptr     (NUL-terminated candidate string)
  //   rsi = prefix_ptr  (NUL-terminated or wire-length prefix bytes)
  //   rdx = prefix_len  (bytes to compare, <= 2^31)
  //   rax = 1 if arg_ptr[0..prefix_len] matches prefix_ptr[0..prefix_len]
  //         AND arg_ptr did not hit its NUL terminator before consuming
  //         the full prefix; 0 otherwise.
  //
  // Used for `--type=`, `--server=`, `--timeout-ms=` where the caller
  // discriminates by prefix only and reads the value bytes at
  // arg_ptr[prefix_len..] itself.
  //
  // Pure leaf, effects: {mem} for the two byte-stream reads.
  // -------------------------------------------------------------------
  pub let argv_parse_prefix : (u64, u64, u64) -> u64
    !{mem} @{} =
    fn (arg_ptr: u64) (prefix_ptr: u64) (prefix_len: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "pdxdig Wave-W (pdxdig#2, #6) ArgvParse::argv_parse_prefix. Byte-by-byte compare of arg_ptr[0..prefix_len] against prefix_ptr[0..prefix_len]. Returns 1 on full-length match, 0 on any byte mismatch or when arg_ptr hits its NUL terminator before prefix_len bytes are consumed (short arg -- `--typ` cannot match `--type=`). Loop counter in rcx; rax caches the arg byte per iteration, r8 the prefix byte. cmp rcx, rdx uses jae so the loop exits cleanly when rcx == prefix_len. Pure leaf under SysV: no callee-save touch, no push/pop, no stack use. Rsp%16==8 at entry from a Main::_start `call` is safe for a leaf that never nests. Effects {mem} for the two byte-stream reads. Encoder discipline (per user memory `pdx encoder pitfalls`): no `test` (every zero-check is `cmp rN, 0`); no 2-op `imul`; no wide-and (unused); byte loads via `xor rax, rax; mov_b rax, [rdi+rcx*1]` and `xor r8, r8; mov_b r8, [rsi+rcx*1]` per paideia-as #1248 REX.W upper-bits contract. Labels prefixed ap_pfx_. Caller-save clobbers: rax, rcx, rdx (unchanged), r8.",
      block: {
        xor rcx, rcx;
      ap_pfx_loop:
        cmp rcx, rdx;
        jae ap_pfx_match;
        xor rax, rax;
        mov_b rax, [rdi + rcx*1];
        cmp rax, 0;
        je ap_pfx_nomatch;
        xor r8, r8;
        mov_b r8, [rsi + rcx*1];
        cmp rax, r8;
        jne ap_pfx_nomatch;
        add rcx, 1;
        jmp ap_pfx_loop;
      ap_pfx_match:
        mov rax, 1;
        ret;
      ap_pfx_nomatch:
        xor rax, rax;
        ret;
      }
    }

  // -------------------------------------------------------------------
  // argv_parse_eq_len(arg_ptr, wanted_ptr, wanted_len) -> u64
  //
  //   rdi = arg_ptr     (NUL-terminated candidate string)
  //   rsi = wanted_ptr  (byte sequence to match, len wanted_len)
  //   rdx = wanted_len  (bytes to compare, <= 2^31)
  //   rax = 1 if arg_ptr matches wanted_ptr for exactly wanted_len
  //         bytes AND arg_ptr[wanted_len] == 0 (NUL immediately after
  //         the matched region); 0 otherwise.
  //
  // Used for `--dry-run` (must not spuriously match a hypothetical
  // `--dry-run-more`). Also usable for any future exact-flag gate
  // (e.g., `--help`, `--version`) that libpdx-argv would classify
  // as FKIND_BOOL.
  //
  // Pure leaf, effects: {mem}.
  // -------------------------------------------------------------------
  pub let argv_parse_eq_len : (u64, u64, u64) -> u64
    !{mem} @{} =
    fn (arg_ptr: u64) (wanted_ptr: u64) (wanted_len: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "pdxdig Wave-W (pdxdig#2, --dry-run gate) ArgvParse::argv_parse_eq_len. Byte-by-byte compare of arg_ptr[0..wanted_len] against wanted_ptr[0..wanted_len]; on full-length match additionally reads arg_ptr[wanted_len] and requires it to be NUL so `--dry-run-extra` does NOT spuriously match `--dry-run`. Returns 1 on exact match, 0 on any byte mismatch, on arg NUL before wanted_len bytes consumed, OR on non-NUL byte at arg_ptr[wanted_len]. Loop identical to argv_parse_prefix with the added tail-NUL check inline before the `mov rax, 1; ret`. Pure leaf; same rsp/callee-save posture as argv_parse_prefix. Effects {mem}. Encoder discipline (per user memory `pdx encoder pitfalls`): no `test`; no 2-op `imul`; no wide-and (unused); byte loads via `xor rax, rax; mov_b rax, [ptr]` + `xor r8, r8; mov_b r8, [ptr]`. Labels prefixed ap_eq_. Clobbers rax, rcx, r8.",
      block: {
        xor rcx, rcx;
      ap_eq_loop:
        cmp rcx, rdx;
        jae ap_eq_tail_nul;
        xor rax, rax;
        mov_b rax, [rdi + rcx*1];
        cmp rax, 0;
        je ap_eq_nomatch;
        xor r8, r8;
        mov_b r8, [rsi + rcx*1];
        cmp rax, r8;
        jne ap_eq_nomatch;
        add rcx, 1;
        jmp ap_eq_loop;
      ap_eq_tail_nul:
        xor rax, rax;
        mov_b rax, [rdi + rcx*1];
        cmp rax, 0;
        jne ap_eq_nomatch;
        mov rax, 1;
        ret;
      ap_eq_nomatch:
        xor rax, rax;
        ret;
      }
    }

  // -------------------------------------------------------------------
  // argv_parse_ipv4(str_ptr) -> u64                          (pdxdig#5)
  //
  //   rdi = str_ptr  (NUL-terminated dotted-quad candidate; caller
  //                    passes arg_ptr + prefix_len, i.e. the bytes
  //                    AFTER `--server=`)
  //   rax = packed IPv4 (MSB-first: octet1<<24 | octet2<<16 |
  //         octet3<<8 | octet4, bits [63:32] always 0 on success)
  //         on a well-formed 4-octet dotted-quad; ALL-ONES
  //         (0xFFFFFFFFFFFFFFFF) on any parse failure. All-ones is
  //         an unambiguous failure sentinel because a successful
  //         parse never sets any bit above bit 31.
  //
  // Grammar: exactly 4 decimal octets (0..255, no leading-zero
  // rejection -- "007" parses as 7), separated by exactly 3 '.'
  // bytes, terminated by NUL. Any other byte, an empty octet (e.g.
  // "1..2.3" or a leading/trailing '.'), an octet > 255, or a wrong
  // octet count (3 or 5+) fails.
  //
  // Used by Main::_start's `--server=` handler (M2-002, pdxdig#5) to
  // parse the value bypassing the not-yet-real "boot-seeded resolver
  // config" -- the packed result is stored directly into
  // `dig_server_override_ip` (Main module, [rip]-addressed).
  //
  // Pure leaf, effects: {mem} for the byte-stream read. No callee-
  // save touch, no push/pop, no stack use -- rsp%16==8 at entry from
  // a Main::_start `call` is fine for a leaf that never nests.
  // -------------------------------------------------------------------
  pub let argv_parse_ipv4 : (u64) -> u64
    !{mem} @{} =
    fn (str_ptr: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "pdxdig.M2-002 (pdxdig#5) ArgvParse::argv_parse_ipv4. Byte-scans str_ptr for exactly 4 decimal octets (0..255) separated by exactly 3 '.' bytes, NUL-terminated. Register plan: rcx = byte index i, rax = packed accumulator (result), r8 = digit_seen flag (0/1, rejects empty octets), r9 = cur_octet accumulator, r10 = octet_count (dots consumed so far, 0..3), r11 = per-iteration scratch (loaded byte / digit), rsi/rdx = multiply-by-10 scratch (old*8 via shl 3, old*2 via shl 1, summed -- avoids the banned 2-op `imul`). Per byte: NUL -> ap_ip_end_octet_final (requires digit_seen=1 AND octet_count==3, i.e. exactly the 4th octet just finished); '.' (0x2E) -> ap_ip_end_octet_dot (requires digit_seen=1 AND octet_count<3, else fails -- rejects empty octets and a 5th+ octet); digit '0'..'9' (0x30..0x39) -> cur_octet = cur_octet*10 + digit via the shl/add shape, then cmp cur_octet, 255 (ja fail) bounds every octet within at most ~3 further digit-iterations regardless of a pathologically long digit run (no unbounded loop); any other byte -> immediate fail. On a '.' or the final NUL: accum = (accum << 8) | cur_octet, octet_count += 1 (dot path only), cur_octet/digit_seen reset (dot path only). Success returns accum (bits [63:32] always 0 since only 4 octets each <=255 are ever shl'd in); failure returns 0xFFFFFFFFFFFFFFFF (all-ones -- unreachable by any successful parse, so it is a safe caller-side sentinel distinguishable from every valid 0.0.0.0..255.255.255.255 result via `cmp rax, r11` against a register-loaded all-ones constant, matching the DnsWalker -ELOOP/-EINVAL comparison idiom in src/dns_walker.pdx). Pure leaf: no callee-save touch, no push/pop, no stack use. Encoder discipline (pdx encoder pitfalls memo): no `test` (every zero/bound check is `cmp reg, imm` or `cmp reg, reg`); no 2-op `imul` (shl+add substitute per the m2-002 design note); no `and rN, imm64` on r8..r15 (`and` is unused entirely in this function); no `neg`; byte loads via `xor r11, r11; mov_b r11, [rdi + rcx*1]` per paideia-as #1248 (REX.W upper-bits contract) with the explicit `*1` scale (paideia-as U1606 bare-index-operand mitigation, matching this file's own ap_pfx_/ap_eq_ loops); every `cmp` immediate <= 57 except the two all-ones sentinel compares, which load the 64-bit constant into a register first (`mov r11, 0xFFFFFFFFFFFFFFFF`) rather than encoding it as a `cmp` immediate. Labels prefixed ap_ip_. Clobbers rax, rcx, rdx, rsi, r8, r9, r10, r11.",
      block: {
        xor rcx, rcx;                            // i = 0
        xor rax, rax;                             // packed accumulator = 0
        xor r8, r8;                                // digit_seen = 0
        xor r9, r9;                                // cur_octet = 0
        xor r10, r10;                              // octet_count = 0

      ap_ip_loop:
        xor r11, r11;
        mov_b r11, [rdi + rcx*1];
        cmp r11, 0;
        je ap_ip_end_octet_final;
        cmp r11, 46;                              // '.'
        je ap_ip_end_octet_dot;
        cmp r11, 48;                              // '0'
        jb ap_ip_fail;
        cmp r11, 57;                              // '9'
        ja ap_ip_fail;

        // cur_octet = cur_octet*10 + digit  (shl/add -- no imul)
        sub r11, 48;                              // r11 = digit
        mov rsi, r9;
        shl rsi, 3;                               // rsi = old*8
        mov rdx, r9;
        shl rdx, 1;                               // rdx = old*2
        add rsi, rdx;                             // rsi = old*10
        add rsi, r11;                             // rsi = old*10 + digit
        mov r9, rsi;
        cmp r9, 255;
        ja ap_ip_fail;
        mov r8, 1;                                // digit_seen = 1
        add rcx, 1;
        jmp ap_ip_loop;

      ap_ip_end_octet_dot:
        cmp r8, 0;                                // empty octet -> fail
        je ap_ip_fail;
        cmp r10, 3;                               // already 3 dots -> 5th octet
        jae ap_ip_fail;
        shl rax, 8;
        or rax, r9;
        add r10, 1;
        xor r9, r9;
        xor r8, r8;
        add rcx, 1;
        jmp ap_ip_loop;

      ap_ip_end_octet_final:
        cmp r8, 0;                                // trailing '.' with no digits
        je ap_ip_fail;
        cmp r10, 3;                               // must be exactly 4 octets
        jne ap_ip_fail;
        shl rax, 8;
        or rax, r9;
        ret;

      ap_ip_fail:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret;
      }
    }

}
