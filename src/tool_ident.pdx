// src/tool_ident.pdx -- pdxdig v1.1.0 (Wave L drain: PDX_TOOL_NAME extern)
// ToolIdent module: per-tool identity externs.
//
// Purpose
// -------
// libpdx-argv 1.1.3+ (ENH-032) reads two UND externs from every tool
// linked against it -- PDX_TOOL_NAME (lowercase, NUL-terminated) and
// PDX_TOOL_VERSION (semver, NUL-terminated) -- so its
// VersionBackend::emit_default can render `<tool> <ver>` on
// `--version` without hard-coding the tool identity into the shared
// library. Every /bin coreutil publishes these two symbols so the
// eventual libpdx-argv bump (^0.1 -> ^1.1) is a manifest edit rather
// than a source edit.
//
// pdxdig at v1.1.0 does NOT yet link libpdx-argv (argv parse is
// inline in src/main.pdx), but the symbols are added preemptively so
// a later M1-002 bump does not require touching this file. Same
// discipline mkdir/cp/cat/mv/rm follow.
//
// paideia-as compliance
// ---------------------
//   - Module ToolIdent (PascalCase basename).
//   - No function bodies -> no register plan, no encoder guardrails.
//   - Array size == literal byte count INCLUDING NUL:
//       "pdxdig\0"  = 7 bytes
//       "1.1.0\0"   = 6 bytes
//   - Both symbols `pub let` (public + immutable = .rodata) so the
//     linker can resolve libpdx-argv's UND refs against them.

module ToolIdent = structure {

  pub let PDX_TOOL_NAME    : [u8; 7] = "pdxdig\0"
  pub let PDX_TOOL_VERSION : [u8; 6] = "1.1.0\0"

}
