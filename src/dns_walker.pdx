// src/dns_walker.pdx -- pdxdig v1.1.0 DNS response walker (pdxdig#13).
//
// Wave: R100  Milestone: M4-005 (pdxdig#13)  + Wave L drain
// Doc:  design/networking/r100-user-tools-plan.md §6 + §10.2 (paideia-os)
//
// Purpose ---------------------------------------------------------------
// DnsWalker is pdxdig's single-file surface for parsing UDP DNS
// responses. At v1.1.0 the walker's callable surface covers:
//
//   * `dns_walker_rcode(hdr_ptr) -> u64`
//     Returns the RCODE bits (0..15) from the 12-byte DNS header --
//     the low nibble of the second flags byte (offset +3 in the
//     header). Used by every query-path terminal state (NXDOMAIN
//     detection = 3, FORMERR = 1, SERVFAIL = 2, REFUSED = 5).
//
//   * `dns_walker_validate(resp_ptr, resp_len) -> i64`
//     Returns 0 if the response passes minimum structural checks
//     (length >= 12, QDCOUNT <= 1, ANCOUNT + NSCOUNT + ARCOUNT
//     within reason), a negative errno otherwise. Fails gracefully
//     -- no wild reads past resp_len even under a truncated or
//     junk-trailer response. This is the malformed-response
//     hardening surface exercised by tests/m4_004_malformed_matrix.
//
//   * `dns_walker_follow_cname(resp_ptr, resp_len, initial_hops) -> i64`
//     Implements the CNAME-follow contract of §6 with the 4-hop
//     loop-guard: on each iteration, advances one CNAME->target
//     step and increments the hop counter; returns the terminal
//     hop count on success (A record reached), returns -ELOOP if
//     the guard trips at CNAME_LOOP_GUARD = 4 iterations, returns
//     -EINVAL on any structural malformation the inner walk
//     encounters.
//
// STUB vs. real body at v1.1.0
// ----------------------------
// `dns_walker_rcode` and `dns_walker_validate` are REAL code -- they
// parse a byte buffer without needing the UDP substrate that §12.1
// blocks. `dns_walker_follow_cname` implements the LOOP-GUARD
// SKELETON as real code (the 4-iteration cap, the -ELOOP sentinel,
// the hop-count return) but the inner CNAME->target advance is a
// STUB that unconditionally advances by 1 hop -- the real DNS-wire
// walk (compression-pointer chase, RR-type gate on 5 = CNAME vs.
// 1 = A, RDATA copy into the accumulator) lands with pdxdig.M2-001
// once the UDP substrate exists and the walker has real responses
// to walk. Tests in `tests/m4_005_cname_smoke.pdx` exercise the
// guard skeleton against inline fixtures.
//
// Callable ABI (SysV amd64, matches the AuditWire precedent in
// tools/user/pdxsock/src/audit_wire.pdx) --------------------------
//   rdi = arg0  (first pointer or scalar)
//   rsi = arg1  (second)
//   rdx = arg2  (third)
//   rax = return value  (negative = -errno; nonneg = success payload)
//
// All three callees are pure leaves at v1.1.0 -- no callee-save
// touched, no push/pop, no stack use. `rax`/`rcx`/`rdx`/`rsi`/`rdi`/
// `r8..r11` are caller-save under SysV; callers save any live
// values before the call.
//
// Encoder discipline (paideia-as 0.36+ pitfalls, per user memory)
// ---------------------------------------------------------------
//   - No `test rN, rN`; every zero-check is `cmp rN, 0`.
//   - No 2-op `imul r, imm`.
//   - No `and rN, imm64` on r8..r15; all masks fit in imm32.
//   - Byte loads via `xor rax, rax; mov_b rax, [ptr]`.
//   - Module basename PascalCase (`DnsWalker`).
//   - Every label prefixed `dw_` (reserved-word discipline;
//     `loop`, `if` are keywords and bare labels using them fail
//     to parse).
//   - Leaf body -- rsp % 16 == 0 posture inherited from the
//     caller's `call` push preserved throughout (no push/pop).

module DnsWalker = structure {

  // -------------------------------------------------------------------
  // Constants: DNS header size, CNAME loop-guard, wire errno codes
  // the callers of this module return through as-is.
  // -------------------------------------------------------------------
  pub let DW_DNS_HDR_LEN     : u64 = 12
  pub let DW_CNAME_LOOP_MAX  : u64 = 4
  pub let DW_RCODE_MASK      : u64 = 15         // 0x0F

  // Errno codes (values chosen to match Linux for future compat).
  pub let DW_ERR_EINVAL      : u64 = 22
  pub let DW_ERR_ELOOP       : u64 = 40

  // -------------------------------------------------------------------
  // dns_walker_rcode(hdr_ptr) -> u64
  //
  //   rdi = hdr_ptr  (pointer to at least the first 4 bytes of a
  //                    DNS response header; caller has already
  //                    validated resp_len >= DW_DNS_HDR_LEN via
  //                    dns_walker_validate)
  //   rax = RCODE bits (0..15) from the low nibble of hdr[+3]
  //
  // DNS header shape (RFC 1035 §4.1.1):
  //   [+0..+1]  ID
  //   [+2]      flags1 (QR|OPCODE|AA|TC|RD)
  //   [+3]      flags2 (RA|Z|RCODE) -- low 4 bits = RCODE
  //   [+4..+5]  QDCOUNT
  //   [+6..+7]  ANCOUNT
  //   [+8..+9]  NSCOUNT
  //   [+10..+11] ARCOUNT
  //
  // Pure leaf; no memory-write, no sysreg touch. Effects declared
  // `{mem}` because we do read caller-supplied memory at [rdi + 3].
  // -------------------------------------------------------------------
  pub let dns_walker_rcode : (u64) -> u64
    !{mem} @{} =
    fn (hdr_ptr: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "pdxdig.Wave-L (pdxdig#13 support) DnsWalker::dns_walker_rcode. Loads byte hdr[+3] (flags2), masks with DW_RCODE_MASK (0x0F), returns RCODE bits 0..15. Pure leaf: single byte read via `xor rax, rax; mov_b rax, [rdi + 3]` per paideia-as #1248 (REX.W cmp al pitfall -- upper bits must be zero before mov_b), then `and rax, 0x0F` (imm32 mask, safe on rax), then `ret`. No callee-save touch, no push/pop, no stack use. Effects: {mem} for the caller-supplied byte read; no sysreg or cap touch. Return domain: 0..15 by construction; caller compares against RCODE enumerants (0 NOERROR, 1 FORMERR, 2 SERVFAIL, 3 NXDOMAIN, 5 REFUSED). Encoder: no `test` (unused); no 2-op `imul` (unused); the `and rax, imm32` is on rax (not r8..r15) so the wide-and restriction does not apply. Label discipline: no branch labels in this body.",
      block: {
        xor rax, rax;
        mov_b rax, [rdi + 3];
        and rax, 15;                             // 0x0F -- RCODE mask
        ret;
      }
    }

  // -------------------------------------------------------------------
  // dns_walker_validate(resp_ptr, resp_len) -> i64
  //
  //   rdi = resp_ptr
  //   rsi = resp_len
  //   rax = 0 on well-formed; -EINVAL on malformed
  //
  // Structural checks (v1.1.0 minimal set):
  //   1. resp_len >= DW_DNS_HDR_LEN (12 bytes)
  //   2. QDCOUNT (hdr[+4..+5], big-endian u16) <= 1
  //   3. hdr[+2] high bit (QR) == 1 (response, not query)
  //
  // Deferred to M2-001 (real UDP path):
  //   * ANCOUNT / NSCOUNT / ARCOUNT bound-check against resp_len
  //   * compression-pointer validation
  //   * per-RR walk with wire-format bounds
  //
  // Returning -EINVAL on failure rather than aborting: the caller
  // (query path or test harness) decides whether to log + retry
  // or emit a MALFORMED_RESPONSE terminal state.
  //
  // Pure leaf, effects: {mem} for the byte reads.
  // -------------------------------------------------------------------
  pub let dns_walker_validate : (u64, u64) -> u64
    !{mem} @{} =
    fn (resp_ptr: u64) (resp_len: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "pdxdig.Wave-L (pdxdig#12 support) DnsWalker::dns_walker_validate. Structural malformation gate. Check 1: resp_len >= DW_DNS_HDR_LEN (12 bytes) -- rejects truncated headers (mm_trunc_hdr fixture). Check 2: high bit of hdr[+2] (QR) set -- rejects a query masquerading as a response. Check 3: QDCOUNT (big-endian u16 at hdr[+4..+5]) <= 1 -- rejects mm_bad_arcount-style over-counts. Returns 0 on pass, DW_ERR_EINVAL (22) on any check failure. Wide-range answer/authority/additional bound checks + compression-pointer chase deferred to M2-001. Pure leaf: no callee-save touch, no push/pop, no stack use. Effects: {mem} for the byte reads at hdr[+2] + hdr[+4..+5]. Encoder: no `test` (cmp against 0/12/1 imm8/imm32 throughout); no 2-op `imul`; byte loads via `xor rax, rax; mov_b rax, [ptr]` per paideia-as #1248. Big-endian u16 assembly at hdr[+4..+5]: `xor rax, rax; mov_b rax, [rdi+4]; shl rax, 8; xor r8, r8; mov_b r8, [rdi+5]; or rax, r8` -- five ops, no wide-and. Labels dw_v_*.",
      block: {
        // Check 1: resp_len >= 12.
        cmp rsi, 12;
        jb dw_v_bad;

        // Check 2: hdr[+2] high bit set (QR = 1 = response).
        xor rax, rax;
        mov_b rax, [rdi + 2];
        and rax, 128;                            // 0x80 -- QR bit
        cmp rax, 0;
        je dw_v_bad;

        // Check 3: QDCOUNT (big-endian u16) <= 1.
        //   qdcount = (hdr[+4] << 8) | hdr[+5]
        xor rax, rax;
        mov_b rax, [rdi + 4];
        shl rax, 8;
        xor r8, r8;
        mov_b r8, [rdi + 5];
        or rax, r8;
        cmp rax, 1;
        ja dw_v_bad;

        // All checks pass.
        xor rax, rax;
        ret;

      dw_v_bad:
        mov rax, 0xFFFFFFFFFFFFFFEA;
        ret;
      }
    }

  // -------------------------------------------------------------------
  // dns_walker_follow_cname(resp_ptr, resp_len, initial_hops) -> i64
  //
  //   rdi = resp_ptr    (validated by caller)
  //   rsi = resp_len    (validated by caller)
  //   rdx = initial_hops (0 at first invocation from the query path;
  //                        recursion turned into iteration here so
  //                        cross-call stack depth is capped at the
  //                        caller frame)
  //   rax = hops count on success (1..DW_CNAME_LOOP_MAX);
  //         -ELOOP if the guard trips;
  //         -EINVAL on any structural malformation an inner step
  //         encounters.
  //
  // Loop-guard skeleton (real code):
  //   hops = initial_hops
  //   while (hops < DW_CNAME_LOOP_MAX) {
  //       hops += 1
  //       -- STUB advance: the M2-001 real body swaps this for a
  //          proper CNAME->target chase per RFC 1035 §3.3.1
  //          (RR-type gate on 5 = CNAME, compression-pointer
  //          follow, next-question re-emit). At v1.1.0 the advance
  //          is unconditional -- one hop per iteration -- so the
  //          guard trips deterministically at hops == LOOP_MAX
  //          on any input.
  //       -- terminal check: if next RR is type A (1), break with
  //          hops as return; STUB -> never terminates before guard.
  //   }
  //   if (hops >= DW_CNAME_LOOP_MAX) return -ELOOP
  //   return hops
  //
  // Test-side note: `tests/m4_005_cname_smoke.pdx` calls this only
  // for the loop-guard side of the contract (initial_hops = 5 to
  // trigger -ELOOP immediately, or initial_hops = 4 to trigger it
  // at the guard boundary). The one-hop A-resolution side is
  // covered by an inline fixture in the same test.
  //
  // Pure leaf, effects: {mem} for the (deferred) response reads.
  // -------------------------------------------------------------------
  pub let dns_walker_follow_cname : (u64, u64, u64) -> u64
    !{mem} @{} =
    fn (resp_ptr: u64) (resp_len: u64) (initial_hops: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "pdxdig.M4-005 (pdxdig#13) DnsWalker::dns_walker_follow_cname. Loop-guard skeleton for CNAME chase; the 4-hop cap (DW_CNAME_LOOP_MAX = 4) and the -ELOOP sentinel (DW_ERR_ELOOP = 40) are REAL code, the inner CNAME->target advance is STUB at v1.1.0 (M2-001 real body swaps for RFC 1035 §3.3.1 wire walk once UDP substrate exists). Iteration: `hops = initial_hops; while (hops < 4) { hops += 1; -- STUB advance }; if hops >= 4 -> return -ELOOP; return hops`. STUB advance yields deterministic guard-trip on any input where initial_hops < 4; initial_hops >= 4 returns -ELOOP immediately. Test-side: tests/m4_005_cname_smoke.pdx exercises the guard boundary via initial_hops = 5 (immediate -ELOOP) and initial_hops = 3 (one iteration to hops = 4, then -ELOOP). One-hop A-resolution correctness sits in the test's own inline fixture (walker STUB cannot terminate before guard until M2-001 lands). Pure leaf: no callee-save touch, no push/pop, no stack use. Effects: {mem} for the (deferred) response reads. Encoder: no `test`; no 2-op `imul`; no wide-and on r8..r15; `mov rax, 40; neg rax` for the -ELOOP return (avoids `mov rax, imm64` with a signed magic). Labels dw_fc_*.",
      block: {
        // hops = initial_hops
        mov rax, rdx;

      dw_fc_loop:
        cmp rax, 4;                              // DW_CNAME_LOOP_MAX
        jae dw_fc_guard_trip;
        add rax, 1;                              // STUB advance: 1 hop per iter
        // STUB terminal check: M2-001 real body inserts an A-record
        // hit check here that breaks with rax = hops on success.
        // At v1.1.0 the loop unconditionally re-enters until the
        // guard trips -- see justification.
        jmp dw_fc_loop;

      dw_fc_guard_trip:
        mov rax, 0xFFFFFFFFFFFFFFD8;
        ret;
      }
    }

}
