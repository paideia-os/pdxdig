// src/main.pdx -- pdxdig v1.2.0 (Wave W drain).
//
// pdxdig: DNS query CLI (`dig`-equivalent). Ring-3 ELF entry point
// (`_start`), argv-wired per the frozen execve ABI:
//   rdi = argc, rsi = argv (VA of a char*[]), rdx = envp (unused),
//   rsp % 16 == 0 at entry.
//
// Wave W "argv-surface + DRY_RUN/UNSUPPORTED_QTYPE branches"
// -------------------------------------------------------------
// Retires the v1.1.0 "argc == 2 gate" argv classifier with a full
// argv walk that peels `--dry-run`, `--type=`, `--server=`, and
// `--timeout-ms=` prefix flags (§6.1 grammar), then dispatches the
// terminal path per the flags. Closes pdxdig#2 (M1-002 argv
// surface), pdxdig#3 (M1-003 first runnable --dry-run), and
// pdxdig#6 (M2-003 UNSUPPORTED_QTYPE handling). The real UDP query
// path (pdxdig#4 / M2-001) remains BLOCKED on §12.1 (SOCK_DGRAM
// extension); the no-flag path still exits 3 with `pdxdig: udp
// stub\n` on fd 2 per v1.1.0.
//
// v1.2.0 argv grammar (subset of §6.1) --------------------------------
//   pdxdig <name>                          -- STUB (unchanged from v1.1.0)
//   pdxdig --dry-run <name>                -- REAL DRY_RUN path, exit 0
//   pdxdig --type=A <name>                 -- treated as bare "<name>"
//   pdxdig --type=<other> <name>           -- UNSUPPORTED_QTYPE, exit 4
//   pdxdig --server=1.2.3.4 <name>         -- recognized, no-op at v1.2
//   pdxdig --timeout-ms=500 <name>         -- recognized, no-op at v1.2
//   pdxdig                                 -- usage on fd 2, exit 2
//   pdxdig -<unknown>                      -- usage on fd 2, exit 2
//   pdxdig -*                              -- last positional wins
//
// Flag/positional order is unconstrained; last positional wins
// (matches dig(1) tail-argument convention).
//
// Exit statuses ------------------------------------------------------
//   0 = --dry-run path taken; record emitted with result_code=DRY_RUN
//   2 = argv usage refusal (no positional OR unknown -flag)
//   3 = no-flag path (v1.1.0 STUB fallback: UDP path not yet wired)
//   4 = --type=<non-A> UNSUPPORTED_QTYPE path
//
// DnsQueryRecord@0.1 layout (48 bytes, @align(8); §10.2 of the R100
// user-tools plan) -- unchanged from v1.1.0:
//
//   [ +0]  magic        [u8; 8] -- "PDXKDIG_" ASCII, LE u64 0x005F474944584450
//   [ +8]  version:u32 | flags:u32
//   [+16]  audit_id     u64
//   [+24]  qname_hash   u64      (rolling-add placeholder)
//   [+32]  qtype:u16 | answer_ip:u32 | ttl_hi:u16   -- qtype=1 (A) always
//   [+40]  ttl_lo:u16 | cname_hops:u8 | txn_id:u16 | result_code:u8 | reserved:u16
//
// Result_code enum (§10.2) -------------------------------------------
//   OK                   = 0   (M2-001 wires this)
//   NXDOMAIN             = 1   (M2-001 wires this)
//   TIMEOUT              = 2   (M2-001 wires this)
//   MALFORMED_RESPONSE   = 3   (M2-001 wires this)
//   UNSUPPORTED_QTYPE    = 4   (this wave -- --type=<non-A>)
//   DRY_RUN              = 5   (unchanged -- --dry-run + STUB fallback)
//
// Schema tag: 0x446E735172797201 -- ASCII-mnemonic ("DnsQry" + 0x01).
//
// Encoder discipline (paideia-as 0.36+ pitfalls, per user memory)
// ---------------------------------------------------------------
//   - No `test rN, rN` (every zero-check is `cmp rN, 0`).
//   - No 2-op `imul r, imm`.
//   - No `and rN, imm64` on r8..r15 (all masks fit in imm32).
//   - No `neg` mnemonic (unused).
//   - Byte loads via `xor rax, rax; mov_b rax, [ptr]`.
//   - Module basename PascalCase (`Main` for `main.pdx`).
//   - Every label prefixed `pdxdig_` (reserved-word discipline;
//     `loop`, `if` etc. are keywords -- bare labels using them fail
//     to parse; see paideia-as reserved-labels memo).
//   - String literals single-line; `[u8; N] = "...\0"` with N =
//     literal-byte-count-including-NUL; sibling `_len` = wire byte
//     count (excludes NUL).
//
// SC+ IDs used:
//   1   = sys_write         (fd, buf, count)      -> n | -errno
//   60  = sys_exit          (status)              -> never returns
//   115 = sys_semantic_send (schema, rec_ptr, len) -> 0 | -errno

module Main = structure {

  // -------------------------------------------------------------------
  // Diagnostic messages. One line each; `_len` sibling is the wire
  // byte count (excludes NUL).
  // -------------------------------------------------------------------
  pub let pdxdig_msg_usage         : [u8; 15] = "pdxdig: usage\n\0"
  pub let pdxdig_msg_usage_len     : u64 = 14

  pub let pdxdig_msg_udp_stub      : [u8; 18] = "pdxdig: udp stub\n\0"
  pub let pdxdig_msg_udp_stub_len  : u64 = 17

  pub let pdxdig_msg_dry_run_ok    : [u8; 20] = "pdxdig: dry-run ok\n\0"
  pub let pdxdig_msg_dry_run_ok_len : u64 = 19

  pub let pdxdig_msg_unsupp_qtype  : [u8; 27] = "pdxdig: unsupported qtype\n\0"
  pub let pdxdig_msg_unsupp_qtype_len : u64 = 26

  // -------------------------------------------------------------------
  // argv-flag name/prefix constants. Each `_len` is the WIRE byte
  // count (excludes trailing NUL) passed to ArgvParse::argv_parse_*.
  //
  //   pdxdig_flag_dry_run  : exact match, 9 wire bytes ("--dry-run")
  //   pdxdig_flag_type     : prefix, 7 wire bytes ("--type=")
  //   pdxdig_flag_server   : prefix, 9 wire bytes ("--server=")
  //   pdxdig_flag_timeout  : prefix, 13 wire bytes ("--timeout-ms=")
  // -------------------------------------------------------------------
  pub let pdxdig_flag_dry_run      : [u8; 10] = "--dry-run\0"
  pub let pdxdig_flag_dry_run_len  : u64 = 9

  pub let pdxdig_flag_type         : [u8; 8]  = "--type=\0"
  pub let pdxdig_flag_type_len     : u64 = 7

  pub let pdxdig_flag_server       : [u8; 10] = "--server=\0"
  pub let pdxdig_flag_server_len   : u64 = 9

  pub let pdxdig_flag_timeout      : [u8; 14] = "--timeout-ms=\0"
  pub let pdxdig_flag_timeout_len  : u64 = 13

  // -------------------------------------------------------------------
  // Semantic-pipe (pdxdig#17) constants + record buffer. Unchanged
  // from v1.1.0 except for the added UNSUPPORTED_QTYPE tail constant.
  //
  // pdxdig_dqr_tail_dry_run : result_code = DRY_RUN (5) tail u64.
  //   Layout: ttl_lo(u16=0) | cname_hops(u8=0) | txn_id(u16=0) |
  //           result_code(u8=5) | reserved(u16=0)
  //   As LE u64 with byte 5 = 0x05:  0x0000050000000000.
  //
  // pdxdig_dqr_tail_unsupp  : result_code = UNSUPPORTED_QTYPE (4) tail u64.
  //   Same shape with byte 5 = 0x04:  0x0000040000000000.
  // -------------------------------------------------------------------
  pub let mut pdxdig_record_buf          : [u8; 48] = uninit @align(8)

  pub let pdxdig_schema_dns_query        : u64 = 0x446E735172797201
  pub let pdxdig_dqr_magic               : u64 = 0x005F474944584450
  pub let pdxdig_dqr_version_and_flags   : u64 = 0x0000000000000001
  pub let pdxdig_dqr_tail_dry_run        : u64 = 0x0000050000000000
  pub let pdxdig_dqr_tail_unsupp         : u64 = 0x0000040000000000

  // -------------------------------------------------------------------
  // _start -- pdxdig entry point. Never returns; every terminal path
  // ends in sys_exit.
  //
  // Register plan (all callee-save regs used so state survives every
  // ArgvParse `call`):
  //   r12 = argc
  //   r13 = argv base
  //   r14 = qname_ptr (0 = not-yet-seen; last positional wins)
  //   r15 = qname_hash accumulator (rolling-add u64 over qname bytes)
  //   rbx = flags bit-set:
  //           bit 0 = --dry-run seen
  //           bit 1 = --type=<non-A> seen (UNSUPPORTED_QTYPE)
  //           bit 2 = unknown -flag seen (-> usage refusal)
  //   rbp = argv loop index i
  //
  // Effects: {mem, sysreg}  Caps: @{fs, sched, cap}
  //   fs   -- sys_write for the diagnostic + fingerprint bands
  //   sched-- sys_exit
  //   cap  -- sys_semantic_send is ungated at R107-M0-001; caps.decl
  //           still names KIND_IPC_ENDPOINT as an optional placeholder
  //           for the future KIND_SEMANTIC_PIPE recv-side gate.
  // -------------------------------------------------------------------
  pub let _start : () -> () !{mem, sysreg} @{fs, sched, cap} =
    fn () -> unsafe {
      effects: {mem, sysreg},
      capabilities: {fs, sched, cap},
      justification: "pdxdig v1.2.0 (Wave W drain) argv-surface _start. Extends the v1.1.0 argc==2 gate to a full argv walk that peels --dry-run (exact match) + --type=/--server=/--timeout-ms= (prefix match) via ArgvParse::argv_parse_eq_len / argv_parse_prefix, then dispatches per-flag. Register plan: r12=argc, r13=argv, r14=qname_ptr (last positional wins, 0=not-yet-seen), r15=qname_hash accumulator, rbx=flag bit-set (bit0=dry_run, bit1=unsupp_qtype, bit2=unknown_flag), rbp=argv loop index i. All callee-save (rbx/rbp/r12..r15) survive every SysV `call` to ArgvParse helpers; no push/pop, rsp%16==0 at entry preserved throughout (helpers are pure leaves that never nest a call, so rsp%16==8 inside them is fine). Argv loop: for each i in 1..argc: read arg_ptr = [r13 + rbp*8]; if byte 0 != '-' (0x2D) it's a positional -> r14 = arg_ptr; else try --dry-run (eq_len 9) -> or rbx, 1; try --type= (prefix 7) -> read arg[7]/arg[8] and require 'A' (0x41) + NUL else or rbx, 2; try --server= (prefix 9) -> no-op; try --timeout-ms= (prefix 13) -> no-op; else or rbx, 4 (unknown flag). After loop: if rbx bit 2 set OR r14 == 0 -> usage exit 2. Compute rolling-add qname hash (matches v1.1.0 placeholder). Marshal 48-byte DnsQueryRecord@0.1 with qtype=1 (A always) and tail chosen per rbx bit 1: unsupp_qtype -> pdxdig_dqr_tail_unsupp (result_code=4); else -> pdxdig_dqr_tail_dry_run (result_code=5, covers both --dry-run path and STUB fallback). Emit via sys_semantic_send (SC+ 115). Terminal dispatch: rbx bit 1 -> `pdxdig: unsupported qtype\\n` fd2 + exit 4; else rbx bit 0 -> `pdxdig: dry-run ok\\n` fd2 + exit 0; else -> `pdxdig: udp stub\\n` fd2 + exit 3 (unchanged v1.1.0 STUB tail). sys_semantic_send return intentionally not inspected (marshalling failure surface, not a per-run condition). Encoder discipline (per user memory `pdx encoder pitfalls`): no `test rN, rN` (every zero-check is `cmp rN, 0`); no 2-op `imul r, imm` (unused); no `and rN, imm64` on r8..r15 (rbx is legacy, safe for `and rbx, imm8`; every other mask fits imm32 on rax); no `neg` mnemonic (unused); byte loads via `xor rax, rax; mov_b rax, [ptr]` per paideia-as #1248 REX.W upper-bits contract; module basename Main; every label prefixed pdxdig_; rip-relative loads/stores proven at sys_semantic_send.pdx lines 214/221; movabs for the 8-byte schema constant same file line 221. Cross-module `call ArgvParse::argv_parse_*` uses the same unqualified-symbol convention as tools/user/mount.pdxfs/src/argv.pdx line 244+ (call site into flag_spec_register, external symbol resolution by function-name at link time).",
      block: {
        // ---- Step 0: latch argc / argv from execve-ABI registers. ----
        mov r12, rdi;                            // r12 = argc
        mov r13, rsi;                            // r13 = argv

        // ---- Step 1: zero flag / positional state. -------------------
        xor r14, r14;                            // qname_ptr = null
        xor r15, r15;                            // qname_hash = 0
        xor rbx, rbx;                            // flags = 0
        mov rbp, 1;                              // i = 1 (skip argv[0])

      pdxdig_argv_loop:
        cmp rbp, r12;
        jae pdxdig_argv_done;

        // Read arg[0] to discriminate flag vs positional.
        mov r9, [r13 + rbp*8];                   // r9 = argv[i] (scratch)
        xor r8, r8;
        mov_b r8, [r9 + 0];
        cmp r8, 45;                              // 0x2D = '-'
        jne pdxdig_arg_positional;

        // ---- Try --dry-run (exact match, 9 bytes). ------------------
        mov rdi, [r13 + rbp*8];
        lea rsi, [rip + pdxdig_flag_dry_run];
        mov rdx, 9;
        call argv_parse_eq_len;
        cmp rax, 0;
        je pdxdig_arg_check_type;
        or rbx, 1;                               // dry_run bit
        jmp pdxdig_argv_next;

      pdxdig_arg_check_type:
        // ---- Try --type= (prefix, 7 bytes). --------------------------
        mov rdi, [r13 + rbp*8];
        lea rsi, [rip + pdxdig_flag_type];
        mov rdx, 7;
        call argv_parse_prefix;
        cmp rax, 0;
        je pdxdig_arg_check_server;

        // Matched --type=. Suffix at arg[7]/arg[8] must be 'A' then NUL.
        mov r9, [r13 + rbp*8];
        xor r8, r8;
        mov_b r8, [r9 + 7];
        cmp r8, 65;                              // 0x41 = 'A'
        jne pdxdig_arg_type_bad;
        xor r8, r8;
        mov_b r8, [r9 + 8];
        cmp r8, 0;
        jne pdxdig_arg_type_bad;
        jmp pdxdig_argv_next;                    // --type=A recognized

      pdxdig_arg_type_bad:
        or rbx, 2;                               // unsupp_qtype bit
        jmp pdxdig_argv_next;

      pdxdig_arg_check_server:
        // ---- Try --server= (prefix, 9 bytes). ------------------------
        mov rdi, [r13 + rbp*8];
        lea rsi, [rip + pdxdig_flag_server];
        mov rdx, 9;
        call argv_parse_prefix;
        cmp rax, 0;
        je pdxdig_arg_check_timeout;
        jmp pdxdig_argv_next;                    // recognized, no-op

      pdxdig_arg_check_timeout:
        // ---- Try --timeout-ms= (prefix, 13 bytes). -------------------
        mov rdi, [r13 + rbp*8];
        lea rsi, [rip + pdxdig_flag_timeout];
        mov rdx, 13;
        call argv_parse_prefix;
        cmp rax, 0;
        je pdxdig_arg_unknown_flag;
        jmp pdxdig_argv_next;                    // recognized, no-op

      pdxdig_arg_unknown_flag:
        or rbx, 4;                               // unknown_flag bit
        jmp pdxdig_argv_next;

      pdxdig_arg_positional:
        mov r14, [r13 + rbp*8];                  // last positional wins
        jmp pdxdig_argv_next;

      pdxdig_argv_next:
        add rbp, 1;
        jmp pdxdig_argv_loop;

      pdxdig_argv_done:
        // ---- Step 2: post-parse gates. -------------------------------
        // Unknown flag -> usage.
        mov rax, rbx;
        and rax, 4;
        cmp rax, 0;
        jne pdxdig_usage;

        // No positional -> usage.
        cmp r14, 0;
        je pdxdig_usage;

        // ---- Step 3: rolling-add hash over the qname bytes. ---------
        xor rcx, rcx;
      pdxdig_hash_loop:
        xor rax, rax;
        mov_b rax, [r14 + rcx*1];
        cmp rax, 0;
        je pdxdig_hash_done;
        add r15, rax;
        add rcx, 1;
        jmp pdxdig_hash_loop;
      pdxdig_hash_done:

        // ---- Step 4: marshal the 48-byte DnsQueryRecord@0.1. --------
        lea r10, [rip + pdxdig_record_buf];

        // magic (inline movabs -- "PDXKDIG_" LE u64).
        mov r11, 0x005F474944584450;
        mov [r10 + 0], r11;

        // version | flags.
        mov r11, [rip + pdxdig_dqr_version_and_flags];
        mov [r10 + 8], r11;

        // audit_id -- zero at v1.2.
        xor r11, r11;
        mov [r10 + 16], r11;

        // qname_hash.
        mov [r10 + 24], r15;

        // qtype (u16=1 = A) packed with answer_ip (u32=0) + ttl_hi (u16=0).
        mov r11, 0x0000000000000001;
        mov [r10 + 32], r11;

        // Tail: choose per rbx bit 1 (unsupp_qtype).
        mov rax, rbx;
        and rax, 2;
        cmp rax, 0;
        jne pdxdig_tail_unsupp;
        mov r11, [rip + pdxdig_dqr_tail_dry_run];
        jmp pdxdig_tail_write;
      pdxdig_tail_unsupp:
        mov r11, [rip + pdxdig_dqr_tail_unsupp];
      pdxdig_tail_write:
        mov [r10 + 40], r11;

        // ---- Step 5: sys_semantic_send(schema, rec_ptr, rec_len). ----
        mov rdi, 0x446E735172797201;             // schema tag (DnsQry@0.1)
        lea rsi, [rip + pdxdig_record_buf];
        mov rdx, 48;                             // rec_len fits [1, 240]
        mov rax, 115;
        syscall;
        // Return value intentionally not inspected.

        // ---- Step 6: terminal dispatch. ------------------------------
        // UNSUPPORTED_QTYPE takes precedence over --dry-run (a rejected
        // --type= is a client-side error regardless of --dry-run).
        mov rax, rbx;
        and rax, 2;
        cmp rax, 0;
        jne pdxdig_exit_unsupp;

        mov rax, rbx;
        and rax, 1;
        cmp rax, 0;
        jne pdxdig_exit_dry_run;

        // Fallthrough: no --dry-run, no --type= -> STUB path (unchanged
        // v1.1.0 behavior: `pdxdig: udp stub\n` fd 2, exit 3).
        mov rdi, 2;
        lea rsi, [rip + pdxdig_msg_udp_stub];
        mov rdx, 17;
        mov rax, 1;
        syscall;
        mov rdi, 3;
        mov rax, 60;
        syscall;
        hlt;

      pdxdig_exit_unsupp:
        mov rdi, 2;
        lea rsi, [rip + pdxdig_msg_unsupp_qtype];
        mov rdx, 26;
        mov rax, 1;
        syscall;
        mov rdi, 4;
        mov rax, 60;
        syscall;
        hlt;

      pdxdig_exit_dry_run:
        mov rdi, 2;
        lea rsi, [rip + pdxdig_msg_dry_run_ok];
        mov rdx, 19;
        mov rax, 1;
        syscall;
        xor rdi, rdi;                            // exit status = 0
        mov rax, 60;
        syscall;
        hlt;

      pdxdig_usage:
        mov rdi, 2;
        lea rsi, [rip + pdxdig_msg_usage];
        mov rdx, 14;
        mov rax, 1;
        syscall;
        mov rdi, 2;                              // exit status = 2 (usage)
        mov rax, 60;
        syscall;
        hlt;
      }
    }

}
